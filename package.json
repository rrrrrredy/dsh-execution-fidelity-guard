{
  "name": "dsh-execution-fidelity-guard",
  "version": "0.1.0-alpha.1",
  "description": "Execution-fidelity guard bundle for DeepSeek Harness",
  "type": "module",
  "main": "index.mjs",
  "exports": {
    ".": "./index.mjs",
    "./contract": "./src/contract.mjs",
    "./policy": "./src/policy.mjs",
    "./package.json": "./package.json"
  },
  "files": [
    "index.mjs",
    "src/**/*.mjs",
    "spec/*.json",
    "examples/contracts/*.json",
    "docs/*.md",
    "cordis.patch.yml",
    "README.md",
    "LICENSE",
    "NOTICE"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  },
  "scripts": {
    "test": "node --test test/unit/contract.test.mjs test/unit/policy.test.mjs test/unit/evidence.test.mjs test/unit/receipts.test.mjs",
    "test:integration": "node --test test/dsh/tool-runtime.test.mjs test/dsh/agent-loop.test.mjs",
    "test:all": "npm run test && npm run test:integration",
    "validate": "node scripts/validate-release.mjs",
    "verify:pack": "node scripts/verify-packed-execution.mjs"
  },
  "engines": {
    "node": "^22.19.0 || >=24.0.0"
  },
  "dependencies": {
    "@deepseek-ai/schemastery": "3.18.2"
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "^4.0.2",
    "@deepseek-ai/dsh-agent": "0.1.2-alpha.2",
    "@deepseek-ai/dsh-llm": "0.1.2-alpha.2",
    "@deepseek-ai/dsh-tools": "0.1.2-alpha.2"
  },
  "devDependencies": {
    "@deepseek-ai/cordis": "4.0.2",
    "@deepseek-ai/dsh-agent": "0.1.2-alpha.2",
    "@deepseek-ai/dsh-agent-loop": "0.1.2-alpha.2",
    "@deepseek-ai/dsh-agent-loop-testkit": "0.1.2-alpha.2",
    "@deepseek-ai/dsh-llm": "0.1.2-alpha.2",
    "@deepseek-ai/dsh-session": "0.1.2-alpha.2",
    "@deepseek-ai/dsh-session-projection": "0.1.2-alpha.2",
    "@deepseek-ai/dsh-system-prompt": "0.1.2-alpha.2",
    "@deepseek-ai/dsh-tools": "0.1.2-alpha.2"
  },
  "keywords": [
    "dsh-plugin",
    "deepseek-harness",
    "agent-safety",
    "execution-fidelity"
  ],
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/rrrrrredy/dsh-execution-fidelity-guard.git"
  },
  "bugs": {
    "url": "https://github.com/rrrrrredy/dsh-execution-fidelity-guard/issues"
  },
  "homepage": "https://github.com/rrrrrredy/dsh-execution-fidelity-guard#readme"
}
