{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/rrrrrredy/dsh-execution-fidelity-guard/spec/task-contract-lite.schema.json",
  "title": "TaskContractLite",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "objective",
    "primary_object",
    "delivery_surface",
    "scope",
    "must_and_must_not",
    "authorization",
    "completion_evidence"
  ],
  "properties": {
    "objective": { "type": "string", "minLength": 1 },
    "primary_object": { "type": "string", "minLength": 1 },
    "delivery_surface": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "type": "string", "minLength": 1 } },
    "scope": {
      "type": "object",
      "additionalProperties": false,
      "required": ["include", "exclude"],
      "properties": {
        "include": { "type": "array", "uniqueItems": true, "items": { "type": "string", "minLength": 1 } },
        "exclude": { "type": "array", "uniqueItems": true, "items": { "type": "string", "minLength": 1 } }
      }
    },
    "must_and_must_not": {
      "type": "object",
      "additionalProperties": false,
      "required": ["must", "must_not"],
      "properties": {
        "must": { "type": "array", "uniqueItems": true, "items": { "type": "string", "minLength": 1 } },
        "must_not": { "type": "array", "uniqueItems": true, "items": { "type": "string", "minLength": 1 } }
      }
    },
    "authorization": {
      "type": "object",
      "additionalProperties": false,
      "required": ["allowed", "requires_user", "forbidden"],
      "properties": {
        "allowed": { "type": "array", "uniqueItems": true, "items": { "type": "string", "minLength": 1 } },
        "requires_user": { "type": "array", "uniqueItems": true, "items": { "type": "string", "minLength": 1 } },
        "forbidden": { "type": "array", "uniqueItems": true, "items": { "type": "string", "minLength": 1 } }
      }
    },
    "completion_evidence": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["requirement", "acceptable_sources"],
        "properties": {
          "requirement": {
            "type": "string",
            "pattern": "^evidence:(file|command|test|api|real_page|release)(:action:(read|write|write_workspace|delete|destructive|install_local|network|publish|external|external_side_effect|unknown))?$"
          },
          "acceptable_sources": {
            "type": "array",
            "minItems": 1,
            "items": { "enum": ["file", "command", "test", "api", "real_page", "release"] }
          }
        }
      }
    }
  }
}
